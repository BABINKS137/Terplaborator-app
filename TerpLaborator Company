style.css
/* =========================
   BASE
========================= */

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    padding: 0;

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    background:
        radial-gradient(
            circle at top,
            #263b55 0%,
            #111923 38%,
            #080c11 100%
        );

    color: #ffffff;

    min-height: 100vh;

    overflow-x: hidden;
}


/* =========================
   APP
========================= */

.app {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;

    padding:
        20px
        16px
        35px;
}


/* =========================
   HEADER
========================= */

.header {
    text-align: center;

    padding:
        10px
        0
        24px;
}

.logo {
    display: block;

    width: 105px;
    height: 105px;

    object-fit: contain;

    margin:
        0 auto
        12px;

    filter:
        drop-shadow(0 0 12px rgba(55, 170, 255, 0.35));
}

.header h1 {
    margin: 0;

    font-size: 27px;
    font-weight: 800;

    letter-spacing: -0.5px;
}

.subtitle {
    margin:
        7px
        0
        0;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 4px;

    opacity: 0.65;
}


/* =========================
   PRODUCTS
========================= */

.products {
    display: flex;

    flex-direction: column;

    gap: 18px;
}


/* =========================
   PRODUCT CARD
========================= */

.product-card {

    overflow: hidden;

    border-radius: 20px;

    background:
        rgba(255, 255, 255, 0.075);

    border:
        1px solid rgba(255, 255, 255, 0.12);

    box-shadow:
        0 10px 35px rgba(0, 0, 0, 0.30);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
}

.product-card:active {
    transform: scale(0.985);
}


/* =========================
   VIDEO
========================= */

.video-container {
    width: 100%;

    background: #05070a;

    position: relative;

    aspect-ratio: 16 / 10;

    overflow: hidden;
}

.video-container video {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    background: #05070a;
}


/* =========================
   PRODUCT INFO
========================= */

.product-info {
    padding:
        14px
        16px
        16px;
}

.product-info h2 {
    margin: 0;

    font-size: 20px;
    font-weight: 750;

    letter-spacing: -0.3px;
}


/* =========================
   FOOTER
========================= */

footer {
    text-align: center;

    padding:
        30px
        0
        5px;

    opacity: 0.45;

    font-size: 12px;
}

footer p {
    margin: 0;
}


/* =========================
   SMALL PHONES
========================= */

@media (max-width: 380px) {

    .app {
        padding-left: 12px;
        padding-right: 12px;
    }

    .header h1 {
        font-size: 24px;
    }

    .logo {
        width: 90px;
        height: 90px;
    }

    .product-info h2 {
        font-size: 18px;
    }

}


/* =========================
   LIGHT TELEGRAM THEME
========================= */

@media (prefers-color-scheme: light) {

    body {
        background:
            linear-gradient(
                145deg,
                #f5f9fc,
                #dfe9f2
            );

        color: #101820;
    }

    .product-card {
        background:
            rgba(255, 255, 255, 0.82);

        border:
            1px solid rgba(0, 0, 0, 0.08);

        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.10);
    }

    .video-container {
        background: #dce5ec;
    }
}
script.js
// =====================================
// TELEGRAM MINI APP
// =====================================

const tg = window.Telegram?.WebApp;


// Initialisation Telegram
if (tg) {

    tg.ready();

    tg.expand();

    // Permet à Telegram d'adapter
    // l'interface à la hauteur disponible.
    if (tg.disableVerticalSwipes) {
        tg.disableVerticalSwipes();
    }
}


// =====================================
// GESTION DES VIDÉOS
// =====================================

const videos = document.querySelectorAll("video");

videos.forEach((video) => {

    video.addEventListener("play", () => {

        // Une seule vidéo à la fois.
        videos.forEach((otherVideo) => {

            if (otherVideo !== video) {
                otherVideo.pause();
            }

        });

    });

});


// =====================================
// VIBRATION TELEGRAM
// =====================================

videos.forEach((video) => {

    video.addEventListener("play", () => {

        if (
            tg &&
            tg.HapticFeedback
        ) {

            tg.HapticFeedback.impactOccurred(
                "light"
            );

        }

    });

});
